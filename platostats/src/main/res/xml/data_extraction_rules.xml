<?xml version="1.0" encoding="utf-8"?>
<!-- Copia de seguridad y traspaso entre dispositivos desde Android 12. Solo se copia
     la base de datos, con las tiradas del tirador. La sesión de Firebase no se copia:
     en un dispositivo nuevo hay que volver a iniciar sesión. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
