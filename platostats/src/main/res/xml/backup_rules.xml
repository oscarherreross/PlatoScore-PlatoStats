<?xml version="1.0" encoding="utf-8"?>
<!-- Copia de seguridad automática de Android hasta Android 11 (desde Android 12
     manda data_extraction_rules.xml). Solo se copia la base de datos, con las tiradas
     del tirador. La sesión de Firebase no se copia: en un dispositivo nuevo hay que
     volver a iniciar sesión. -->
<full-backup-content>
    <include domain="database" path="." />
</full-backup-content>
