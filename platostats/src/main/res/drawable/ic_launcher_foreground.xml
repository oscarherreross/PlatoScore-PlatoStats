<?xml version="1.0" encoding="utf-8"?>
<!-- Primer plano del icono adaptativo (PROVISIONAL): monograma "S" de PlatoStats
     con el plato en el hueco superior de la letra, hermano de la "P" de PlatoScore.
     Todo el arte vive dentro de la zona segura (círculo central de 66) del lienzo de 108. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- La S: dos arcos de radio 11 (centros 54,43 y 54,65) con trazo grueso y extremos redondos -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FBF5EE"
        android:strokeWidth="8.5"
        android:strokeLineCap="round"
        android:pathData="M62.43,35.93 A11,11 0 1,0 54,54 A11,11 0 1,1 45.57,72.07" />

    <!-- Cúpula del plato (grafito) en el hueco superior -->
    <path
        android:fillColor="#37474F"
        android:pathData="M49.4,43 a4.6,4.6 0 1,0 9.2,0 a4.6,4.6 0 1,0 -9.2,0 Z" />

    <!-- Reborde del plato (crema fino) -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FBF5EE"
        android:strokeWidth="0.9"
        android:pathData="M49.4,43 a4.6,4.6 0 1,0 9.2,0 a4.6,4.6 0 1,0 -9.2,0 Z" />

    <!-- Punto central del plato (naranja) -->
    <path
        android:fillColor="#FF9152"
        android:pathData="M52.4,43 a1.6,1.6 0 1,0 3.2,0 a1.6,1.6 0 1,0 -3.2,0 Z" />
</vector>
