<?xml version="1.0" encoding="utf-8"?>
<!-- Primer plano del icono adaptativo de PlatoStats: una gráfica de evolución que
     sube y termina en el plato (cúpula grafito, reborde crema y punto naranja).
     Todo el arte vive dentro de la zona segura (círculo central de 66) del lienzo de 108. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Línea de la gráfica (crema), con uniones y extremos redondos -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FBF5EE"
        android:strokeWidth="6.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M32,72.5 L45.5,58 L57.5,64 L72.5,41" />

    <!-- Último punto de la gráfica: el plato. Cúpula (grafito) -->
    <path
        android:fillColor="#37474F"
        android:pathData="M65,41 a7.5,7.5 0 1,0 15,0 a7.5,7.5 0 1,0 -15,0 Z" />

    <!-- Reborde del plato (crema) -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FBF5EE"
        android:strokeWidth="1.5"
        android:pathData="M65,41 a7.5,7.5 0 1,0 15,0 a7.5,7.5 0 1,0 -15,0 Z" />

    <!-- Punto central del plato (naranja) -->
    <path
        android:fillColor="#FF9152"
        android:pathData="M69.9,41 a2.6,2.6 0 1,0 5.2,0 a2.6,2.6 0 1,0 -5.2,0 Z" />
</vector>
