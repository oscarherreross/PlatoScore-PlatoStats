<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Modo noche · Grafito nocturno: barra grafito oscura y naranja como color de acento. -->
    <style name="Theme.PlatoScore" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- El naranja se usa como acento (botones, enlaces, línea principal de la gráfica). -->
        <item name="colorPrimary">@color/naranja_acento</item>
        <item name="colorPrimaryVariant">@color/naranja</item>
        <!-- Texto/iconos sobre el naranja de acento (p. ej. botones rellenos): negro por contraste. -->
        <item name="colorOnPrimary">@color/black</item>
        <!-- Secundario (FAB): grafito claro para que se vea sobre el fondo oscuro. -->
        <item name="colorSecondary">@color/grafito_claro</item>
        <item name="colorSecondaryVariant">@color/grafito</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Barra de app: grafito oscuro (no se tiñe con el naranja en modo noche). -->
        <item name="platoAppBar">@color/grafito_oscuro</item>
        <item name="platoOnAppBar">@color/white</item>
        <!-- La barra de estado acompaña a la barra de app. -->
        <item name="android:statusBarColor">?attr/platoAppBar</item>
        <!-- Customize your theme here. -->
    </style>
</resources>
