<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_nombre_tirada"
        android:textStyle="bold"
        android:layout_marginBottom="6dp"
        android:labelFor="@id/etNombreTirada" />

    <EditText
        android:id="@+id/etNombreTirada"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="textCapSentences"
        android:hint="@string/hint_nombre_tirada"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_fecha"
        android:textStyle="bold"
        android:layout_marginBottom="6dp"
        android:labelFor="@id/etFechaTirada" />

    <EditText
        android:id="@+id/etFechaTirada"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="none"
        android:focusable="false"
        android:clickable="true"
        android:cursorVisible="false"
        android:longClickable="false" />

</LinearLayout>
