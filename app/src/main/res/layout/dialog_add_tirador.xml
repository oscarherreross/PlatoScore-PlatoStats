<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_nombre_apellidos"
            android:textStyle="bold"
            android:layout_marginBottom="6dp"
            android:labelFor="@id/etNombreApellidos" />

        <AutoCompleteTextView
            android:id="@+id/etNombreApellidos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPersonName"
            android:hint="@string/hint_nombre_apellidos"
            android:completionThreshold="1"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_dni"
            android:textStyle="bold"
            android:layout_marginBottom="6dp"
            android:labelFor="@id/etDni" />

        <EditText
            android:id="@+id/etDni"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:hint="@string/hint_dni"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_numero_licencia"
            android:textStyle="bold"
            android:layout_marginBottom="6dp"
            android:labelFor="@id/etNumeroLicencia" />

        <EditText
            android:id="@+id/etNumeroLicencia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:hint="@string/hint_numero_licencia"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_platos_rotos"
            android:textStyle="bold"
            android:layout_marginBottom="6dp"
            android:labelFor="@id/etPlatosRotos" />

        <EditText
            android:id="@+id/etPlatosRotos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:hint="@string/hint_platos_rotos"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_categoria"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <CheckBox
            android:id="@+id/cbLocal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/categoria_local" />

        <CheckBox
            android:id="@+id/cbJunior"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/categoria_junior" />

        <CheckBox
            android:id="@+id/cbSenior"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/categoria_senior" />

        <CheckBox
            android:id="@+id/cbDama"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/categoria_dama" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
