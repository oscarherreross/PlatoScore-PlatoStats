<?xml version="1.0" encoding="utf-8"?>
<!-- Primer plano del icono adaptativo: monograma "P" de PlatoScore con el plato en el ojo de la letra.
     El cuenco de la P se apoya a la altura del palo (no sobresale por arriba).
     Todo el arte vive dentro de la zona segura (círculo central de 66) del lienzo de 108. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Astil de la P (crema) -->
    <path
        android:fillColor="#FBF5EE"
        android:pathData="M41.5,31 L45.5,31 A3,3 0 0 1 48.5,34 L48.5,77 A3,3 0 0 1 45.5,80 L41.5,80 A3,3 0 0 1 38.5,77 L38.5,34 A3,3 0 0 1 41.5,31 Z" />

    <!-- Cuenco de la P como anillo crema (el hueco deja ver el naranja del fondo) -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FBF5EE"
        android:strokeWidth="8.5"
        android:pathData="M43.75,48 a11.75,11.75 0 1,0 23.5,0 a11.75,11.75 0 1,0 -23.5,0 Z" />

    <!-- Cúpula del plato (grafito) dentro del ojo de la P -->
    <path
        android:fillColor="#37474F"
        android:pathData="M49.5,48 a6,6 0 1,0 12,0 a6,6 0 1,0 -12,0 Z" />

    <!-- Reborde del plato (crema fino) -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FBF5EE"
        android:strokeWidth="1"
        android:pathData="M49.5,48 a6,6 0 1,0 12,0 a6,6 0 1,0 -12,0 Z" />

    <!-- Punto central del plato (naranja) -->
    <path
        android:fillColor="#FF9152"
        android:pathData="M53.5,48 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0 Z" />
</vector>
