<?xml version="1.0" encoding="utf-8"?>
<!-- Copia de seguridad y traspaso entre dispositivos desde Android 12. Solo se copia
     la base de datos. Como guarda DNI y licencias de terceros, a la nube solo sube si
     la copia va cifrada con el bloqueo de pantalla del dispositivo. La sesión de
     Firebase no se copia: en un dispositivo nuevo hay que volver a iniciar sesión. -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
