<?xml version="1.0" encoding="utf-8"?>
<!-- Copia de seguridad automática de Android hasta Android 11 (desde Android 12
     manda data_extraction_rules.xml). Solo se copia la base de datos y, como guarda
     DNI y licencias de terceros, solo cuando la copia va cifrada con el bloqueo de
     pantalla del dispositivo (Android 9 o posterior; antes, el requisito se ignora).
     La sesión de Firebase no se copia: en un dispositivo nuevo hay que volver a
     iniciar sesión. -->
<full-backup-content>
    <include domain="database" path="." requireFlags="clientSideEncryption" />
</full-backup-content>
