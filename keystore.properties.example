# Plantilla de la firma de publicación. Copia este archivo como keystore.properties
# (está en el .gitignore: nunca se sube) y pon tus datos. Ver PUBLICACION.md.
#
# Ruta del almacén de claves: absoluta, o relativa a la raíz del proyecto.
# Guárdalo fuera del repositorio y con copia de seguridad.
storeFile=C:/ruta/a/plato-subida.jks
storePassword=CONTRASENA_DEL_ALMACEN
keyAlias=subida
keyPassword=CONTRASENA_DE_LA_CLAVE
